# ============================================================
# BOB — Grid Trading Bot para GRVT
# Copia este archivo como backend/.env y completa los valores
# ============================================================

# --- GRVT Credentials ---
# Private key de la wallet (para firma EIP-712, manejada por el SDK)
GRVT_PRIVATE_KEY=your_private_key_here

# API key generada desde el dashboard de GRVT
GRVT_API_KEY=your_api_key_here

# Trading account ID (visible en GRVT UI → Account)
GRVT_TRADING_ACCOUNT_ID=your_trading_account_id_here

# --- Ambiente ---
# "testnet" o "mainnet" — NUNCA usar mainnet hasta completar Fase 10
GRVT_ENV=testnet

# --- Backend ---
BOB_HOST=0.0.0.0
BOB_PORT=8000
BOB_LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Limites globales ---
MAX_TOTAL_CAPITAL=1000
MAX_CONCURRENT_BOTS=5
MAX_LEVERAGE=10
