# ============================================================
# BOB — Asistente de Decisión para Trading Intradía
# Copia este archivo como backend/.env y completa los valores
# BOB nunca ejecuta órdenes: NO se necesitan API keys de trading.
# ============================================================

# --- Backend ---
BOB_HOST=0.0.0.0
BOB_PORT=8000
BOB_LOG_LEVEL=INFO

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Watchlist ---
# Símbolos de Binance Futures separados por coma. ETHUSDT es el inicial.
BOB_WATCHLIST=ETHUSDT
BOB_DEFAULT_TIMEFRAME=15m

# --- Señales ---
# Umbral mínimo del KPI Seguridad para emitir señal (0-1)
BOB_SIGNAL_THRESHOLD=0.70

# --- Datos en vivo (Fase 1) ---
# false = backend sin WS de Binance ni snapshots (modo offline para backtest)
BOB_LIVE_DATA=true
# auto | ws | rest. "auto" prueba el WebSocket y cae a polling REST si el WS
# conecta pero no entrega frames (pasa en algunas redes: ver DATA_SOURCES.md).
BOB_FEED_MODE=auto
# Granularidad y cadencia del snapshot de OI / ratios long-short.
# Binance solo guarda ~30 días de esa historia: si el backend no corre, se pierde.
BOB_SNAPSHOT_PERIOD=15m
BOB_SNAPSHOT_INTERVAL_MIN=30

# --- Telegram (alertas) ---
# Crear bot con @BotFather → token; chat id con @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Outliers Club (Fase 8, opcional) ---
# Credenciales SOLO locales. Nunca commitear el .env real.
OUTLINERS_EMAIL=
OUTLINERS_PASSWORD=
