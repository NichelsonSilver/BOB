# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/

# Node
node_modules/
frontend/dist/
# Cache incremental de tsc: cambia en cada build y ensucia todos los diffs.
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Cobertura de tests
.coverage
htmlcov/

# Logs
logs/
*.log

# Docker
docker-compose.override.yml

# ── Secretos ──
# Nunca se versionan. Solo viajan las plantillas *.example.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.pfx
*.p12
*.crt
credentials.json
service-account*.json

# ── Datos ──
# La DB de mercado son ~70k velas + derivados: se reconstruye con
# `download.py`, no se versiona.
*.db
*.db-journal
*.sqlite
*.sqlite3
*.csv
*.parquet

# Excepción deliberada: los artefactos del gate y del forward SÍ van al repo.
# El veredicto de una fase tiene que salir de un archivo verificable y no de un
# resumen escrito a mano (README § "Veredicto del gate"). Hoy son .txt/.json,
# que el bloqueo de arriba no toca; la negación está para que un reporte futuro
# en .csv no desaparezca en silencio.
!backend/artifacts/**

# Capturas de Outliners (contenido de pago, §15 de sus Términos): nunca versionar
screnshots/
